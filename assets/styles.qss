QMainWindow {
    background-color: #F7F1E8;
}

QWidget#sidebar {
    background-color: #8B5E34;
    padding: 15px;
}

QLabel#logo {
    color: white;
    font-size: 22px;
    font-weight: bold;
    padding: 10px 5px 25px 5px;
}

QWidget#sidebar QPushButton {
    color: #F5F5F5;
    background-color: transparent;
    border: none;
    padding: 12px 15px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    border-radius: 10px;
    margin-bottom: 5px;
}

QWidget#sidebar QPushButton:hover {
    background-color: #A47148;
}

QWidget#sidebar QPushButton:checked {
    background-color: #B5834A;
    color: white;
}

QLineEdit,
QComboBox {
    background-color: white;
    border: 1px solid #D8C3A5;
    border-radius: 10px;
    padding: 8px;
    color: #5C4033;
    font-size: 13px;
}

QLineEdit:focus,
QComboBox:focus {
    border: 2px solid #B5834A;
}

QTableWidget {
    background-color: white;
    color: #5C4033;
    border-radius: 10px;
    border: 1px solid #E6D5C3;
    gridline-color: #E6D5C3;
}

QHeaderView::section {
    background-color: #F5E6D3;
    color: #5C4033;
    padding: 8px;
    font-weight: bold;
    border: none;
}

QPushButton {
    background-color: #B5834A;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #9C6B3D;
}

QFrame#card {
    background-color: white;
    border: 1px solid #E6D5C3;
    border-radius: 15px;
    padding: 15px;
}