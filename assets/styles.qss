QMainWindow {
    background-color: #F7F2EC;
}

QWidget#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #A67C52, stop:1 #7F5A3A);
    padding: 15px;
}

QLabel#logo {
    color: #FFF8EE;
    font-size: 20px;
    font-weight: bold;
    padding: 10px 5px 25px 5px;
}

QWidget#sidebar QPushButton {
    color: #F5EBDD;
    background-color: transparent;
    border: none;
    padding: 12px 15px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    margin-bottom: 5px;
}

QWidget#sidebar QPushButton:hover {
    background-color: #8C6643;
    color: #FFFDFB;
}

QWidget#sidebar QPushButton:checked {
    background-color: #C79B72;
    color: #FFFDFB;
}

QLineEdit, QComboBox {
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #FFFFFF;
    color: #334155;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #38BDF8;
}

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    gridline-color: #E2E8F0;
    border-radius: 8px;
    color: #334155;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    padding: 8px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #E2E8F0;
}

QPushButton {
    background-color: #A67C52;
    color: #FFFDF9;
    border: none;
    padding: 8px 16px;
    font-weight: 600;
    border-radius: 6px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #8C6643;
}

QPushButton#btnHapus {
    background-color: #EF4444;
}

QPushButton#btnHapus:hover {
    background-color: #DC2626;
}

QFrame#card {
    background-color: #FFFDFB;
    border: 1px solid #E6D8C8;
    border-radius: 10px;
    padding: 15px;
}